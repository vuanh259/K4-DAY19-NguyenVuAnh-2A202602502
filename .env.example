# Copy to .env (never commit .env). Fill AT LEAST ONE key; the first one found is used
# in this order: OpenAI -> OpenRouter -> Gemini -> Anthropic. Anthropic is chat-only
# (no embedding API), so with only ANTHROPIC_API_KEY you also need one of the other three for embeddings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a provider instead of the order above
# LLM_PROVIDER=openai          # openai | openrouter | gemini | anthropic
# EMBEDDING_PROVIDER=openai    # openai | openrouter | gemini

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GenZShop/ModelAPI Codex gateway (requires a token created on modelapi.vn,
# not the shop redemption code). Embedding support must be checked separately.
# OPENAI_BASE_URL=https://api.modelapi.vn/v1
# OPENAI_CHAT_API=responses
# OPENAI_CHAT_MODEL=gpt-6.1-sol
# Default OPENAI_CHAT_API is chat_completions for direct OpenAI API.
# Other compatible providers also accept <PROVIDER>_BASE_URL / <PROVIDER>_CHAT_API.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_MIN_INTERVAL=0.8
# Optional measured account/gateway rates per million tokens (USD or gateway credits):
# OPENAI_CHAT_INPUT_USD_PER_M=1.8
# OPENAI_CHAT_OUTPUT_USD_PER_M=9
# OPENAI_CHAT_CACHED_INPUT_USD_PER_M=0.09
# GEMINI_EMBEDDING_INPUT_USD_PER_M=0  # only when using the free tier
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
